<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime là điều kiện bắt buộc để notarize, và nó KHOÁ sẵn micro:
	     không có entitlement này thì AVFoundation lấy mic trả về im lặng/lỗi, kể cả
	     khi Info.plist đã khai NSMicrophoneUsageDescription và user đã bấm Allow.
	     Đây là entitlement duy nhất app cần — Screen Recording và Accessibility đi
	     qua TCC (System Settings), không qua entitlement; app KHÔNG sandbox (sandbox
	     sẽ chặn ghi màn hình toàn hệ thống + đọc AX của app khác). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
